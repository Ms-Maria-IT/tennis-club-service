<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <property name="CONSOLE_LOG_PATTERN" 
              value="%d{ISO8601} [%thread] %-5level [traceId=%X{traceId:-}, spanId=%X{spanId:-}] %logger{36} - %msg%n"/>
    
    <!-- Console output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="io.micrometer" level="DEBUG"/>
    <logger name="io.micrometer.tracing" level="DEBUG"/>
    
    <logger name="com.tennistournament" level="DEBUG"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>